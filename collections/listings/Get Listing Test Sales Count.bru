meta {
  name: Get Listing by ID (Test Sales Count)
  type: http
  seq: 10
}

get {
  url: http://localhost:8080/api/listings/{{listingId}}
  body: none
  auth: inherit
}

vars:pre-request {
  listingId: 67123456789abcdef1234567
}

tests {
  test("Should return listing with salesCount", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('salesCount');
    expect(res.getBody().salesCount).to.be.a('number');
    expect(res.getBody().salesCount).to.be.at.least(0);
  });
}
