meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "fullName": "John Doe",
    "email": "john.doe@example.com",
    "password": "securePassword123",
    "cpf": "12345678901",
    "cnpj": "12345678901234",
    "isSeller": true
  }
}

tests {
  test("should register user successfully", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().accessToken).to.be.a('string');
    expect(res.getBody().refreshToken).to.be.a('string');
    expect(res.getBody().userId).to.be.a('string');
    expect(res.getBody().tokenType).to.equal('Bearer');
  });
  
  // Store tokens for other requests
  if (res.getStatus() === 201) {
    bru.setVar("access_token", res.getBody().accessToken);
    bru.setVar("refresh_token", res.getBody().refreshToken);
    bru.setVar("user_id", res.getBody().userId);
  }
}
